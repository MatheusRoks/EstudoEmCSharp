<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
	<CodeSnippet Format="1.0.0">
		<Header>
			<Title>Console ReadLine</Title>
			<Shortcut>cr</Shortcut>
			<Description>Lê uma entrada do console e armazena em uma variável.</Description>
		</Header>
		<Snippet>
			<Declarations>
				<Literal>
					<ID>name</ID>
					<ToolTip>Nome da variável</ToolTip>
					<Default>name</Default>
				</Literal>
			</Declarations>
			<Code Language="CSharp">
				<![CDATA[string $name$ = Console.ReadLine();]]>
			</Code>
		</Snippet>
	</CodeSnippet>
</CodeSnippets>
